{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "width",
    "height",
    "fps",
    "duration",
    "background",
    "palette",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 320
    },
    "height": {
      "type": "integer",
      "minimum": 240
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "background": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "captionStyle": {
      "type": "object",
      "additionalProperties": true
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "purpose",
          "semanticRefs",
          "visualRule",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "purpose": {
            "type": "string"
          },
          "semanticRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "beat": {
            "enum": [
              "hook",
              "setup",
              "escalation",
              "reveal",
              "explanation",
              "comparison",
              "proof",
              "payoff",
              "cta"
            ]
          },
          "visualRule": {
            "type": "string"
          },
          "camera": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "static",
                  "pan",
                  "push",
                  "follow"
                ]
              },
              "fromX": {
                "type": "number"
              },
              "toX": {
                "type": "number"
              },
              "fromY": {
                "type": "number"
              },
              "toY": {
                "type": "number"
              },
              "fromScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "toScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "easing": {
                "enum": [
                  "linear",
                  "easeOut",
                  "easeInOut"
                ]
              }
            },
            "additionalProperties": false
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "fade"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "rect",
                    "circle",
                    "line",
                    "arrow",
                    "path",
                    "text",
                    "caption",
                    "group",
                    "character",
                    "prop"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "cx": {
                  "type": "number"
                },
                "cy": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                },
                "x1": {
                  "type": "number"
                },
                "y1": {
                  "type": "number"
                },
                "x2": {
                  "type": "number"
                },
                "y2": {
                  "type": "number"
                },
                "d": {
                  "type": "string"
                },
                "points": {
                  "type": "string"
                },
                "fill": {
                  "type": "string"
                },
                "stroke": {
                  "type": "string"
                },
                "strokeWidth": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fontSize": {
                  "type": "number"
                },
                "fontWeight": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "fontFamily": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "characterId": {
                  "type": "string"
                },
                "variant": {
                  "type": "string"
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "motion": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "fade",
                        "slide",
                        "scale",
                        "draw",
                        "emphasis",
                        "bob",
                        "shake",
                        "travel",
                        "rotate",
                        "pop"
                      ]
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "easing": {
                      "enum": [
                        "linear",
                        "easeOut",
                        "easeInOut"
                      ]
                    },
                    "dx": {
                      "type": "number"
                    },
                    "dy": {
                      "type": "number"
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    },
                    "fromX": {
                      "type": "number"
                    },
                    "toX": {
                      "type": "number"
                    },
                    "fromY": {
                      "type": "number"
                    },
                    "toY": {
                      "type": "number"
                    },
                    "amount": {
                      "type": "number"
                    },
                    "cycles": {
                      "type": "number"
                    },
                    "openAt": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "wheelTurns": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keyPoses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "time"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "time": {
                  "type": "number",
                  "minimum": 0
                },
                "pose": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "start",
                "end",
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "action": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "phase": {
                  "enum": [
                    "anticipation",
                    "action",
                    "reaction",
                    "settle",
                    "continuous"
                  ]
                },
                "pose": {
                  "type": "string"
                },
                "expression": {
                  "type": "string"
                },
                "gaze": {
                  "enum": [
                    "left",
                    "center",
                    "right",
                    "up",
                    "down"
                  ]
                },
                "easing": {
                  "enum": [
                    "linear",
                    "easeOut",
                    "easeInOut"
                  ]
                },
                "causedBy": {
                  "type": "string"
                },
                "interaction": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "contactAt",
                    "response",
                    "feedback"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "touch",
                        "grab",
                        "hit",
                        "push",
                        "tap",
                        "kick"
                      ]
                    },
                    "contactAt": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "hand": {
                      "enum": [
                        "left",
                        "right"
                      ]
                    },
                    "causes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "response": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "none",
                            "impulse",
                            "nudge"
                          ]
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "vx": {
                          "type": "number"
                        },
                        "vy": {
                          "type": "number"
                        },
                        "gravity": {
                          "type": "number"
                        },
                        "rotateSpeed": {
                          "type": "number"
                        },
                        "dx": {
                          "type": "number"
                        },
                        "dy": {
                          "type": "number"
                        },
                        "rotate": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    },
                    "feedback": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "color": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
