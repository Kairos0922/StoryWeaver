{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "width",
    "height",
    "fps",
    "duration",
    "background",
    "palette",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 320
    },
    "height": {
      "type": "integer",
      "minimum": 240
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "background": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "captionStyle": {
      "type": "object",
      "additionalProperties": true
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "purpose",
          "semanticRefs",
          "visualRule",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "purpose": {
            "type": "string"
          },
          "semanticRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "beat": {
            "enum": [
              "hook",
              "setup",
              "escalation",
              "reveal",
              "explanation",
              "comparison",
              "proof",
              "payoff",
              "cta"
            ]
          },
          "visualRule": {
            "type": "string"
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "fade"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "rect",
                    "circle",
                    "line",
                    "arrow",
                    "path",
                    "text",
                    "caption",
                    "group",
                    "character"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "cx": {
                  "type": "number"
                },
                "cy": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                },
                "x1": {
                  "type": "number"
                },
                "y1": {
                  "type": "number"
                },
                "x2": {
                  "type": "number"
                },
                "y2": {
                  "type": "number"
                },
                "d": {
                  "type": "string"
                },
                "points": {
                  "type": "string"
                },
                "fill": {
                  "type": "string"
                },
                "stroke": {
                  "type": "string"
                },
                "strokeWidth": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fontSize": {
                  "type": "number"
                },
                "fontWeight": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "fontFamily": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "characterId": {
                  "type": "string"
                },
                "variant": {
                  "type": "string"
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "motion": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "fade",
                        "slide",
                        "scale",
                        "draw",
                        "emphasis"
                      ]
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "easing": {
                      "enum": [
                        "linear",
                        "easeOut",
                        "easeInOut"
                      ]
                    },
                    "dx": {
                      "type": "number"
                    },
                    "dy": {
                      "type": "number"
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
