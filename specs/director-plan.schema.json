{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","reference","styleGuide","story","beatSheet","shotList","timeline","review"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "reference":{"type":"object","additionalProperties":false,"required":["sources"],"properties":{"sources":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}}},
    "styleGuide":{"type":"object","additionalProperties":false,"required":["palette","typography","composition","motion","identity"],"properties":{"palette":{"type":"array","minItems":1,"items":{"type":"string"}},"typography":{"type":"string"},"composition":{"type":"string"},"motion":{"type":"string"},"identity":{"type":"array","items":{"type":"string"}}}},
    "story":{"type":"object","additionalProperties":false,"required":["hook","progression","payoff"],"properties":{"hook":{"type":"string"},"progression":{"type":"array","minItems":1,"items":{"type":"string"}},"payoff":{"type":"string"}}},
    "beatSheet":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","start","end","purpose"],"properties":{"id":{"type":"string"},"start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},"purpose":{"type":"string"},"viewerRead":{"type":"string"},"audio":{"type":"string"}}}},
    "shotList":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","start","end","beatId","startState","endState","action"],"properties":{"id":{"type":"string"},"start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},"beatId":{"type":"string"},"startState":{"type":"string"},"endState":{"type":"string"},"action":{"type":"string"},"actor":{"type":"string"},"target":{"type":"string"},"camera":{"type":"string"},"viewerRead":{"type":"string"},"audio":{"type":"string"}}}},
    "timeline":{"type":"object","additionalProperties":false,"required":["fps","events"],"properties":{"fps":{"type":"integer","minimum":1,"maximum":60},"events":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","time","kind"],"properties":{"id":{"type":"string"},"time":{"type":"number","minimum":0},"kind":{"enum":["beat","audio","visual","camera","transition"]},"ref":{"type":"string"}}}}}},
    "review":{"type":"object","additionalProperties":false,"required":["checks","repairLoop"],"properties":{"checks":{"type":"array","items":{"type":"string"}},"repairLoop":{"const":["render","inspect","diagnose","repair","rerender","reinspect"]}}}
  }
}
