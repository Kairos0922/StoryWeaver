{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source",
    "claims",
    "scenes",
    "duration"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "enum": [
              "fact",
              "definition",
              "cause",
              "effect",
              "comparison",
              "sequence",
              "quantity",
              "state"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "palette": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "captionStyle": {
      "type": "object",
      "additionalProperties": true
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "time"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "purpose",
          "semanticRefs",
          "visualRule",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "purpose": {
            "type": "string"
          },
          "semanticRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "beat": {
            "enum": [
              "hook",
              "setup",
              "escalation",
              "reveal",
              "explanation",
              "comparison",
              "proof",
              "payoff",
              "cta"
            ]
          },
          "visualRule": {
            "type": "string"
          },
          "camera": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "static",
                  "pan",
                  "push",
                  "follow"
                ]
              },
              "fromX": {
                "type": "number"
              },
              "toX": {
                "type": "number"
              },
              "fromY": {
                "type": "number"
              },
              "toY": {
                "type": "number"
              },
              "fromScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "toScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "easing": {
                "enum": [
                  "linear",
                  "easeOut",
                  "easeInOut"
                ]
              }
            },
            "additionalProperties": false
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "fade"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "layer": {
                  "type": "integer"
                },
                "z": {
                  "type": "integer"
                }
              }
            }
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keyPoses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "time"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "time": {
                  "type": "number",
                  "minimum": 0
                },
                "pose": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "start",
                "end",
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "action": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "phase": {
                  "enum": [
                    "anticipation",
                    "action",
                    "reaction",
                    "settle",
                    "continuous"
                  ]
                },
                "pose": {
                  "type": "string"
                },
                "expression": {
                  "type": "string"
                },
                "gaze": {
                  "enum": [
                    "left",
                    "center",
                    "right",
                    "up",
                    "down"
                  ]
                },
                "easing": {
                  "enum": [
                    "linear",
                    "easeOut",
                    "easeInOut"
                  ]
                },
                "causedBy": {
                  "type": "string"
                },
                "interaction": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "contactAt",
                    "response",
                    "feedback"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "touch",
                        "grab",
                        "hit",
                        "push",
                        "tap",
                        "kick"
                      ]
                    },
                    "contactAt": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "hand": {
                      "enum": [
                        "left",
                        "right"
                      ]
                    },
                    "causes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "response": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "none",
                            "impulse",
                            "nudge"
                          ]
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "vx": {
                          "type": "number"
                        },
                        "vy": {
                          "type": "number"
                        },
                        "gravity": {
                          "type": "number"
                        },
                        "rotateSpeed": {
                          "type": "number"
                        },
                        "dx": {
                          "type": "number"
                        },
                        "dy": {
                          "type": "number"
                        },
                        "rotate": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    },
                    "feedback": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "color": {
                          "type": "string"
                        }
                      }
                    },
                    "audio": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cue": {
                          "type": "string"
                        },
                        "offset": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
