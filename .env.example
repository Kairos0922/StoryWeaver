# Copy to .env on the machine that runs TTS. Never commit secrets.
# Cloud agents without keys stop at a silent preview.

TTS_PROVIDER=doubao
# TTS_PROVIDER=azure
# TTS_PROVIDER=elevenlabs

# Doubao / Volcengine OpenSpeech
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_API_KEY=

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs
ELEVENLABS_API_KEY=

# Optional render overrides
# CHROME=/usr/bin/google-chrome-stable
# SW_FONT_400=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# SW_FONT_500=
# SW_FONT_700=
# SW_FONT_900=
