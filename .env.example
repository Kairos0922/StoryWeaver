# Copy to .env on the machine that runs TTS. Never commit secrets.
# Cloud agents without keys stop at a silent draft preview.

TTS_PROVIDER=doubao
# TTS_PROVIDER=dry-run

# Doubao / Volcengine speech synthesis
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_API_KEY=

# Optional Doubao V3 adapter overrides
# DOUBAO_TTS_SPEAKER=zh_female_xiaohe_uranus_bigtts
# DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# Optional render overrides
# CHROME=/usr/bin/google-chrome-stable
# SW_FONT_400=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# SW_FONT_500=
# SW_FONT_700=
# SW_FONT_900=
