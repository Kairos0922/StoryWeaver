{
  "name": "storyweaver",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Content-to-video compiler for deterministic programmatic visual storytelling.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node src/cli.js validate examples/hot-air-balloon.json",
    "render": "node src/cli.js render examples/hot-air-balloon.json --out out/hot-air-balloon.mp4",
    "quality": "node scripts/quality-gate.js",
    "lint": "node src/cli.js lint",
    "inspect": "node src/cli.js inspect",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "method-proof": "node scripts/method-proof.js",
    "production-01": "node scripts/production-01.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.17.1",
    "ffmpeg-static": "^5.2.0",
    "text2wav": "0.0.14"
  }
}
