{
  "language": "zh",
  "speakers": ["等等", "阿规", "嘀嗒", "旁白", "Narrator"],
  "forbidden": [
    {"id": "meta-plain-speech", "pattern": "说人话", "severity": "error", "message": "Meta-narration. State the conflict; do not announce that you will speak plainly."},
    {"id": "meta-simply", "pattern": "简单来说", "severity": "error", "message": "Scaffold transition."},
    {"id": "meta-in-other-words", "pattern": "换句话说", "severity": "error", "message": "Scaffold transition."},
    {"id": "scaffold-remember", "pattern": "记住一件事", "severity": "error", "message": "Summary scaffold. Put the list on screen; keep one principle in the voice."},
    {"id": "scaffold-so-dash", "pattern": "所以(?:—|–|―|－|-){1,3}", "regex": true, "severity": "error", "message": "“所以——” is a slide transition, not speech."},
    {"id": "scaffold-worth", "pattern": "值得一提", "severity": "error", "message": "Scaffold cliché."},
    {"id": "scaffold-have-you", "pattern": "你有没有想过", "severity": "error", "message": "Explainer-open cliché."},
    {"id": "scaffold-let-us", "pattern": "让我们", "severity": "error", "message": "Explainer-open cliché."},
    {"id": "scaffold-in-sum", "pattern": "总而言之", "severity": "error", "message": "Wrap-up cliché."},
    {"id": "scaffold-not-only", "pattern": "不仅[^。！？!?]{0,40}更", "regex": true, "severity": "error", "message": "“不仅…更…” is canned parallelism."}
  ],
  "oral_ordinal": {
    "id": "oral-ordinal",
    "pattern": "第[一二三四五六七八九十百]+[，,、]",
    "severity": "error",
    "message": "The voice is reading a list. Put items on cards; say one principle."
  },
  "method_in_vo": {
    "id": "method-in-vo",
    "pattern": "假设",
    "severity": "warning",
    "message": "Method or assumption entered the voice-over. Move it to the fact card, a caption, or the end card."
  },
  "emoji": {
    "id": "emoji",
    "pattern": "[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]",
    "severity": "error",
    "message": "No emoji in voice-over or captions."
  },
  "max_sentence_chars": 40,
  "count_unit": "chars",
  "long_sentence": {
    "id": "long-sentence",
    "severity": "warning",
    "message": "Sentence is longer than 40 characters. One beat, one number; split it."
  },
  "five_beats": ["Hook", "Break the assumption", "Mechanism", "Payoff", "Audience stance", "钩子", "打碎常识", "内幕", "真相", "评论站队"],
  "five_beat_severity": "warning",
  "pace": {
    "id": "pace",
    "unit": "chars",
    "max_per_s_line": 4.6,
    "max_per_s_speech_avg": 4.0,
    "comfortable_per_s": 3.7,
    "severity": "error"
  },
  "key_number_pause": {
    "id": "key-number-pause",
    "min_pause_after_s": 0.9,
    "pattern": "[零一二三四五六七八九十百千万半两\\d]+(成|%|秒|分钟|倍|个人|人)",
    "severity": "error"
  },
  "one_number_per_line": {
    "id": "one-number",
    "max_numbers_per_line": 1,
    "severity": "warning"
  },
  "new_concepts_in_hook": {
    "id": "hook-concepts",
    "window_s": 10,
    "max_new_terms": 1,
    "severity": "warning"
  }
}
