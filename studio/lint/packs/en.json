{
  "language": "en",
  "speakers": ["Narrator", "Host", "Guest"],
  "forbidden": [
    {"id": "meta-plain-speech", "pattern": "in plain English", "severity": "error", "message": "Meta-narration. State the conflict; do not announce that you will speak plainly."},
    {"id": "meta-simply", "pattern": "simply put", "severity": "error", "message": "Scaffold transition."},
    {"id": "meta-in-other-words", "pattern": "in other words", "severity": "error", "message": "Scaffold transition."},
    {"id": "scaffold-remember", "pattern": "remember this one thing", "severity": "error", "message": "Summary scaffold. Put the list on screen; keep one principle in the voice."},
    {"id": "scaffold-so-dash", "pattern": "so(?:—|–|―|－|-){1,3}", "regex": true, "severity": "error", "message": "“So—” is a slide transition, not speech."},
    {"id": "scaffold-worth", "pattern": "it's worth noting", "severity": "error", "message": "Scaffold cliché."},
    {"id": "scaffold-worth-2", "pattern": "worth mentioning", "severity": "error", "message": "Scaffold cliché."},
    {"id": "scaffold-have-you", "pattern": "have you ever wondered", "severity": "error", "message": "Explainer-open cliché."},
    {"id": "scaffold-let-us", "pattern": "let us", "severity": "error", "message": "Explainer-open cliché."},
    {"id": "scaffold-in-sum", "pattern": "all in all", "severity": "error", "message": "Wrap-up cliché."},
    {"id": "scaffold-in-conclusion", "pattern": "in conclusion", "severity": "error", "message": "Wrap-up cliché."},
    {"id": "scaffold-not-only", "pattern": "not only.{0,40}but also", "regex": true, "severity": "error", "message": "“Not only… but also…” is canned parallelism."},
    {"id": "scaffold-delve", "pattern": "delve", "severity": "error", "message": "AI-flavored verb. Use a concrete action."},
    {"id": "scaffold-landscape", "pattern": "in today's landscape", "severity": "error", "message": "AI-flavored opener."},
    {"id": "scaffold-tapestry", "pattern": "tapestry", "severity": "error", "message": "AI-flavored metaphor."}
  ],
  "oral_ordinal": {
    "id": "oral-ordinal",
    "pattern": "\\b(First|Second|Third|Fourth|Fifth),",
    "severity": "error",
    "message": "The voice is reading a list. Put items on cards; say one principle."
  },
  "method_in_vo": {
    "id": "method-in-vo",
    "pattern": "assume",
    "severity": "warning",
    "message": "Method or assumption entered the voice-over. Move it to the fact card, a caption, or the end card."
  },
  "emoji": {
    "id": "emoji",
    "pattern": "[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]",
    "severity": "error",
    "message": "No emoji in voice-over or captions."
  },
  "max_sentence_chars": 90,
  "max_sentence_words": 22,
  "count_unit": "words",
  "long_sentence": {
    "id": "long-sentence",
    "severity": "warning",
    "message": "Sentence is longer than 22 words. One beat, one number; split it."
  },
  "five_beats": ["Hook", "Break the assumption", "Mechanism", "Payoff", "Audience stance"],
  "five_beat_severity": "warning",
  "pace": {
    "id": "pace",
    "unit": "words",
    "max_per_s_line": 3.2,
    "max_per_s_speech_avg": 2.8,
    "severity": "error"
  },
  "key_number_pause": {
    "id": "key-number-pause",
    "min_pause_after_s": 0.9,
    "pattern": "\\b(\\d+|one|two|three|four|five|six|seven|eight|nine|ten|half)\\b.{0,12}\\b(%|percent|seconds?|minutes?|times|people)\\b",
    "severity": "error"
  },
  "one_number_per_line": {
    "id": "one-number",
    "max_numbers_per_line": 1,
    "severity": "warning"
  },
  "new_concepts_in_hook": {
    "id": "hook-concepts",
    "window_s": 10,
    "max_new_terms": 1,
    "severity": "warning"
  }
}
