{
  "schema": "storyweaver.qc.v1",
  "episode": "{{episode}}",
  "items": [
    {
      "id": "fact_card_abc",
      "gate": "1",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "fact_card_abc",
      "title": "Fact card has A (sources) / B (this episode’s numbers) / C (do-not-say)"
    },
    {
      "id": "one_thing",
      "gate": "0",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "one_thing",
      "title": "The episode states one takeaway, not a placeholder"
    },
    {
      "id": "brief_ready",
      "gate": "2",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "brief_approved",
      "title": "Creative brief is human-approved; body hash, aspect, and duration still match"
    },
    {
      "id": "techniques",
      "gate": "2",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "techniques",
      "title": "Brief-stage checks of every technique selected in ## Approach pass (none selected passes)"
    },
    {
      "id": "style_lock",
      "gate": "2",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "style_lock",
      "title": "Episode stays inside the series style lock (palette, fonts, characters, camera, motion subset)"
    },
    {
      "id": "intuition_addressed",
      "gate": "2",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "intuition_addressed",
      "title": "Viewer intuition / strongest objection is filled and answered before the first break"
    },
    {
      "id": "script_lint",
      "gate": "2",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "script_lint",
      "title": "Voice-over lint has no scaffold errors"
    },
    {
      "id": "claim_precision",
      "gate": "2",
      "blocks": [
        "lines",
        "hook-sample",
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "claim_precision",
      "title": "Numbers declare quantity type (average / individual / fairness / tail-risk / proportion)"
    },
    {
      "id": "pace_ok",
      "gate": "3",
      "blocks": [
        "render",
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "pace_ok",
      "title": "Speech rate and pauses after key numbers stay inside the language cap"
    },
    {
      "id": "metrics_not_invented",
      "gate": "6",
      "blocks": [
        "publish"
      ],
      "required": true,
      "kind": "auto",
      "check": "metrics_not_invented",
      "title": "Playback metrics are blank or sourced on the same line; no estimate words"
    },
    {
      "id": "ear_hook",
      "gate": "3",
      "blocks": [
        "stills",
        "render",
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "A person heard the ~12s hook sample. ASR scores do not replace this.",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "first_watch",
      "gate": "3",
      "blocks": [
        "render",
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Someone who has not read the script watches the hook (or silent preview) once and can restate the one thing plus one objection",
      "status": "pending",
      "evidence": "",
      "checked_by": "",
      "evidence_template": "Viewer: __ (not the author or an agent) | Restate: __ | Objection: __ | Line changed: __"
    },
    {
      "id": "stills_four",
      "gate": "4",
      "blocks": [
        "render",
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Four stills reviewed by eye: hook, first number, payoff, closing stance",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "beat_clock",
      "gate": "4",
      "blocks": [
        "render",
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Timeline uses a 2.5s visual beat; no stretch longer than 5s without a new visual",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "no_idle",
      "gate": "4",
      "blocks": [
        "render",
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Every beat has at least one character action; no standing-and-listening",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "ear_numbers",
      "gate": "5",
      "blocks": [
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "After the full mix, a person heard every number line and every character name. ASR is assistive only.",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "loudnorm",
      "gate": "5",
      "blocks": [
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Mix loudness matches the pipeline target −16 LUFS. Do not invent a reading without a mix.",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "sim_disclaimer",
      "gate": "5",
      "blocks": [
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Simulated numbers are labeled as a simplified model on screen or at the end; schematic motion is not sold as a field measurement",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    },
    {
      "id": "ai_disclosure",
      "gate": "6",
      "blocks": [
        "publish"
      ],
      "required": true,
      "kind": "human",
      "title": "Publish copy includes an AI-generated disclosure. A person clicks publish. Agents do not post.",
      "status": "pending",
      "evidence": "",
      "checked_by": ""
    }
  ]
}
